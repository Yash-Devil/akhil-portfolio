# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact-form submissions
CONTACT_TO_EMAIL=akhil@abould.com

# Sender address. MUST be on a domain you've verified in Resend.
# For testing before your domain is verified, use:
#   CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Portfolio <contact@abould.com>
